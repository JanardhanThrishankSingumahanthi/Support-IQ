# Copy this file to .env and fill in your local values.
# Do not commit the real .env file.

APP_ENV=development
APP_PORT=8000

# Example service configuration
API_BASE_URL=http://localhost:8000

# LLM / AI provider configuration
OPENAI_API_KEY=
GEMINI_API_KEY=

# Retrieval / vector database configuration
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# Authentication / session security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# Storage / document pipeline
UPLOAD_DIR=./data/uploads
KNOWLEDGE_BASE_DIR=./data/knowledge

# Optional: model / training configuration
MODEL_NAME=
MODEL_PATH=
TRAINING_BATCH_SIZE=8
MAX_SEQUENCE_LENGTH=2048
